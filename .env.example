# Copia este archivo como .env.local y completa los valores de tu proyecto Supabase
# (Dashboard → Project Settings → API). La clave publicable es segura en el navegador;
# NUNCA uses aquí la service_role / secret key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# URL pública del sitio (para enlaces de calendario y redirecciones)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
